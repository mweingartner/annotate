<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The Mac App Store build: the same sandbox, plus the identity its provisioning profile
     grants, which lets API keys live in the data-protection keychain. -->
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key><true/>
    <key>com.apple.security.files.user-selected.read-write</key><true/>
    <key>com.apple.security.network.client</key><true/>
    <key>com.apple.security.print</key><true/>
    <key>com.apple.application-identifier</key><string>X2J8TBQJWE.com.mweingar.Annotate</string>
    <key>com.apple.developer.team-identifier</key><string>X2J8TBQJWE</string>
    <key>keychain-access-groups</key>
    <array><string>X2J8TBQJWE.com.mweingar.Annotate</string></array>
</dict>
</plist>
